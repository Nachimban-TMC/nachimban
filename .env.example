# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요.
#   cp .env.example .env
# .env 는 깃허브에 올라가지 않습니다(.gitignore).
# 여기에 값을 넣어두면 매일 자동 실행(예약작업)에서도 알림/메일이 발송됩니다.

# 앱 푸시 — Netlify 환경변수 PUSH_ADMIN_TOKEN 과 똑같은 값
PUSH_ADMIN_TOKEN=

# 이메일 발송 (선택) — Resend
RESEND_API_KEY=
NB_FROM=나침반 <onboarding@resend.dev>

# 실제 뉴스 수집을 API로 돌릴 때만 필요 (지금은 예약작업 방식이라 불필요)
# ANTHROPIC_API_KEY=
